{"data":{"list":[{"author":"claude","facet":"css","label":"camera: unfix #dvrgoeshere - fixed traps modals below the veil","new":"#dvrgoeshere {\n  /* absolute, not fixed: position:fixed creates a stacking context in\n     Blink, trapping every modal opened from inside (the settings\n     dialog's z-index:15 loses to the body-level backdrop at z-index:5\n     and the whole app renders under the veil, clicks included).\n     .cammain already pins this same rectangle. */\n  position:absolute;\n  top:0px;\n  left:0px;\n  right:0px;\n  bottom:0px;\n}","old":"#dvrgoeshere {\n  position:fixed;\n  top:62px;\n  left:0px;\n  right:0px;\n  bottom:0px;\n}","patch_id":"p1","time":1786624253499},{"author":"agent","facet":"css","label":"C3: the standalone page scrolls a tile taller than the window","new":".cammain{\n  position:absolute;\n  top:62px;\n  left:0px;\n  bottom:0px;\n  right:0px;\n  /* C3: the tile's height follows its content now (picture at full width\n     + tab bar + tab content), which can exceed the window - scroll the\n     page body instead of clipping the tabs away */\n  overflow-y:auto;\n}","old":".cammain{\n  position:absolute;\n  top:62px;\n  left:0px;\n  bottom:0px;\n  right:0px;\n}","patch_id":"p2","time":1793959610663},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> camera.camera","new":"[\n{\"claim\": \"A test instance (rig) copied from a checkout has no camera/target/release/libcamera.so (target/ is excluded), so hotswap loads nothing and every camera command is 'No such command' (404 over the peer proxy); copy the dylib into <rig>/camera/target/release/ and restart.\", \"detail\": \"Session 3 Phase 0 (2026-11-06). FFI crates are discovered from data/camera/meta.json (cargo.ffi=true), not the generated initializer. Also: a rig's runtime/dev/repos.json may point camera at the LIVE checkout with autocommit on, so the rig's sweeper commits into the live branch; set autocommit false in every rig copy. Lab: rpicam-vid/rpicam-still shims on PATH feeding ffmpeg testsrc2 with -re (without it lavfi outruns real time).\", \"tags\": \"camera,rig,dylib,hotswap,lab,autocommit\", \"source\": {\"lib\": \"camera\", \"ctl\": \"camera\", \"facet\": \"js\", \"hash\": \"98eac1f8f544d515\"}, \"confidence\": \"high\", \"time\": 1793967587378},\n{\"end\": true}]\n","old":"","patch_id":"p3","time":1793967591050},{"author":"claude","facet":"html","label":"titlebar: the shared app:home control, like every other app","new":"    <div class='data-control' data-control='app:home:{}' style='display:contents'></div>\n    <span class='nb-title'>Camera</span>","old":"    <a href='../app/index.html'><img src='../app/asset/app/menu_icon.png' class='menuicon'></a>\n    Camera","patch_id":"p4","time":1794160197735}]},"id":"iljipm18439e7022bl69_patches","readers":[],"time":1794160197735,"username":"system","writers":[]}