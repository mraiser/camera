:32px;\n  padding:0;\n  border:none;\n  background-color:transparent;\n  cursor:pointer;\n  vertical-align:middle;\n}\n\n.live-wrap .dvr-settings-button{\n  margin-right:20px;\n}\n\n.live-wrap .dvr-settings-button img{\n  display:block;\n  width:32px;\n  height:32px;\n}\n\n.live-wrap .fullscreen-button, .live-wrap .fullscreen-exit-button{\n  background-image: url(../app/asset/app/fullscreen_icon.png);\n  background-size:cover;\n  display:inline-block;\n}\n\n.live-wrap .fullscreen-button:hover, .live-wrap .fullscreen-exit-button:hover{\n  background-image: url(../app/asset/app/fullscreen_icon_hover.png);\n}\n\n.live-wrap .fullscreen-exit-button{\n  background-image: url(../app/asset/app/fullscreen_exit_icon.png);\n  display:none;\n}\n\n.live-wrap .fullscreen-exit-button:hover{\n  background-image: url(../app/asset/app/fullscreen_exit_icon_hover.png);\n}\n\n/* .upper-right centers against the nearest positioned ancestor - anchor\n   the close X to the dialog header, not the whole 620px dialog */\n.camera-settings-popup .dialog-header{\n  position:relative;\n}\n\n.camera-settings-popup{\n  display:none;\n  width:1024px;\n  /* vw, not %: the popup kit measures this element while it is briefly\n     position:absolute inside its host (the HUD panel is ~600px wide),\n     then centers it as position:fixed - a %-based max-width resolves\n     differently in the two states and mis-centers the dialog */\n  max-width:90vw;\n  height:620px;\n  background-color:white;\n  color:black;\n}","old":".live-wrap {\n  height:100%;\n  position:relative;\n  text-align:center;\n}\n\n.live-wrap .live-img {\n  position:relative;\n  max-width:100%;\n  max-height:100%;\n  margin-left:auto;\n  margin-right:auto;\n}\n\n.live-wrap .live-img-ctrls{\n  position:absolute;\n  right:20px;\n  bottom:20px;\n  padding:5px;\n  background-color:#88888888;\n}\n\n.live-wrap .fullscreen-button, .live-wrap .fullscreen-exit-button{\n  width:32px;\n  height:32px;\n  background-image: url(../app/asset/app/fullscreen_icon.png);\n  background-size:cover;\n  display:inline-block;\n}\n\n.live-wrap .fullscreen-button:hover, .live-wrap .fullscreen-exit-button:hover{\n  background-image: url(../app/asset/app/fullscreen_icon_hover.png);\n}\n\n.live-wrap .fullscreen-exit-button{\n  background-image: url(../app/asset/app/fullscreen_exit_icon.png);\n  display:none;\n}\n\n.live-wrap .fullscreen-exit-button:hover{\n  background-image: url(../app/asset/app/fullscreen_exit_icon_hover.png);\n}\n\n.live-wrap .dvr-settings-button{\n  width:32px;\n  height:32px;\n  display:inline-block;\n  margin-right:20px;\n}\n\n/* .upper-right centers against the nearest positioned ancestor - anchor\n   the close X to the dialog header, not the whole 620px dialog */\n.camera-settings-popup .dialog-header{\n  position:relative;\n}\n\n.camera-settings-popup{\n  display:none;\n  width:1024px;\n  /* vw, not %: the popup kit measures this element while it is briefly\n     position:absolute inside its host (the HUD panel is ~600px wide),\n     then centers it as position:fixed - a %-based max-width resolves\n     differently in the two states and mis-centers the dialog */\n  max-width:90vw;\n  height:620px;\n  background-color:white;\n  color:black;\n}","patch_id":"p19","time":1793959586544},{"author":"agent","facet":"js","label":"C3: fullscreen the picture area; icon state from fullscreenchange; refused requests caught","new":"// C3: ⛶ fullscreens the whole picture area (the dvr control's aspect box,\n// so DVR playback and snapshots ride along); standalone fallback is this\n// control's own wrap. The UA stretches the fullscreen element to the\n// screen and object-fit letterboxes the picture.\nfunction fsTarget(){\n  var pw = $(ME).closest('.picture-wrap');\n  return pw.length ? pw[0] : $(ME).find('.live-wrap')[0];\n}\n\n// C3: icons swap ONLY on fullscreenchange, so every exit path (Esc, the\n// exit button, the browser's own UI) restores them, and a refused request\n// changes nothing because no event fires. Document-level listener: it\n// unhooks itself once this mount leaves the page.\nfunction fsSync(){\n  if (!ME.isConnected) {\n    document.removeEventListener('fullscreenchange', fsSync);\n    document.removeEventListener('webkitfullscreenchange', fsSync);\n    return;\n  }\n  var fs = document.fullscreenElement || document.webkitFullscreenElement;\n  var active = !!fs && fs.contains(ME);\n  $(ME).find('.fullscreen-button').css('display', active ? 'none' : 'inline-block');\n  $(ME).find('.fullscreen-exit-button').css('display', active ? 'inline-block' : 'none');\n  $(ME).find('.dvr-settings-button').css('display', active ? 'none' : 'inline-block');\n}\ndocument.addEventListener('fullscreenchange', fsSync);\ndocument.addEventListener('webkitfullscreenchange', fsSync);\n\n$(ME).find('.fullscreen-button').click(function(){\n  var elem = fsTarget();\n  var p = null;\n  try {\n    if (elem.requestFullscreen) p = elem.requestFullscreen();\n    else if (elem.webkitRequestFullscreen) p = elem.webkitRequestFullscreen(); /* Safari */\n  } catch(e) {}\n  if (p && p.catch) p.catch(function(){});\n});\n\n$(ME).find('.fullscreen-exit-button').click(function(){\n  try {\n    if (document.exitFullscreen) document.exitFullscreen();\n    else if (document.webkitExitFullscreen) document.webkitExitFullscreen(); /* Safari */\n  } catch(e) {}\n});","old":"$(ME).find('.fullscreen-button').click(function(){\n  var elem = $(ME).find('.live-wrap')[0];\n  if (elem.requestFullscreen) {\n    elem.requestFullscreen();\n  } else if (elem.webkitRequestFullscreen) { /* Safari */\n    elem.webkitRequestFullscreen();\n  } else if (elem.msRequestFullscreen) { /* IE11 */\n    elem.msRequestFullscreen();\n  }\n  $(this).css('display', 'none');\n  $(ME).find('.fullscreen-exit-button').css('display', 'inline-block');\n  $(ME).find('.dvr-settings-button').css('display', 'none');\n});\n\n\n$(ME).find('.fullscreen-exit-button').click(function(){\n  if (document.exitFullscreen) {\n    document.exitFullscreen();\n  } else if (document.webkitExitFullscreen) { /* Safari */\n    document.webkitExitFullscreen();\n  } else if (document.msExitFullscreen) { /* IE11 */\n    document.msExitFullscreen();\n  }\n  $(this).css('display', 'none');\n  $(ME).find('.dvr-settings-button').css('display', 'inline-block');\n  $(ME).find('.fullscreen-button').css('display', 'inline-block');\n});","patch_id":"p20","time":1793959602272},{"author":"agent","facet":"js","label":"step 0a: iPhone Safari full screen falls back to the video","new":"$(ME).find('.fullscreen-button').click(function(){\n  var elem = fsTarget();\n  var p = null;\n  try {\n    if (elem.requestFullscreen) p = elem.requestFullscreen();\n    else if (elem.webkitRequestFullscreen) p = elem.webkitRequestFullscreen(); /* Safari */\n    else { /* iPhone Safari: no element full screen - the video itself can */\n      var v = fsVideo();\n      if (v) v.webkitEnterFullscreen();\n    }\n  } catch(e) {}\n  if (p && p.catch) p.catch(function(){});\n});\n\n// the video showing in this picture area (DVR playback or live) - iPhone\n// Safari offers video-only full screen through webkitEnterFullscreen\nfunction fsVideo(){\n  var pw = $(ME).closest('.picture-wrap');\n  var scope = pw.length ? pw[0] : ME;\n  var vids = scope.querySelectorAll('video');\n  var fallback = null;\n  for (var i = 0; i < vids.length; i++) {\n    if (!vids[i].webkitEnterFullscreen) continue;\n    if (!fallback) fallback = vids[i];\n    if (vids[i].offsetParent !== null) return vids[i];\n  }\n  return fallback;\n}","old":"$(ME).find('.fullscreen-button').click(function(){\n  var elem = fsTarget();\n  var p = null;\n  try {\n    if (elem.requestFullscreen) p = elem.requestFullscreen();\n    else if (elem.webkitRequestFullscreen) p = elem.webkitRequestFullscreen(); /* Safari */\n  } catch(e) {}\n  if (p && p.catch) p.catch(function(){});\n});","patch_id":"p21","time":1793962322599},{"author":"agent","facet":"js","label":"step 0a: hide the full screen button when nothing can go full screen","new":"  if (ME.DATA.controls == false) $(ME).find('.live-img-ctrls').css('display', 'none');\n  // step 0a: when nothing on this UA can go full screen (iPhone Safari has\n  // no element fullscreen and no video webkitEnterFullscreen), hide the button\n  var fsprobe = $(ME).find('.live-wrap')[0];\n  if (!fsprobe.requestFullscreen && !fsprobe.webkitRequestFullscreen && !$(ME).find('.live-video')[0].webkitEnterFullscreen) {\n    $(ME).find('.fullscreen-button').css('display', 'none');\n  }\n  if (me.status.device) start();","old":"  if (ME.DATA.controls == false) $(ME).find('.live-img-ctrls').css('display', 'none');\n  if (me.status.device) start();","patch_id":"p22","time":1793962331642},{"author":"agent","facet":"html","label":"C4: Connecting… instead of a black video","new":"  <video class='live-video' muted autoplay playsinline style='display:none;'></video>\n  <img class='live-img'>\n  <div class='live-connecting'>Connecting…</div>","old":"  <video class='live-video' muted autoplay playsinline style='display:none; background-color:black;'></video>\n  <img class='live-img'>","patch_id":"p23","time":1793962377596},{"author":"agent","facet":"css","label":"C4: Connecting… style","new":".live-wrap {\n  width:100%;\n  height:100%;\n  position:relative;\n  text-align:center;\n}\n\n/* C4: \"Connecting…\" on the tile's own background while the stream starts */\n.live-wrap .live-connecting {\n  display:none;\n  position:absolute;\n  top:50%;\n  left:0;\n  width:100%;\n  transform:translateY(-50%);\n  text-align:center;\n  padding:0 16px;\n  box-sizing:border-box;\n  color:var(--text-dim);\n}","old":".live-wrap {\n  width:100%;\n  height:100%;\n  position:relative;\n  text-align:center;\n}","patch_id":"p24","time":1793962395198},{"author":"agent","facet":"js","label":"C4: Connecting… while the stream starts","new":"function start(){\n  showConnecting(true);\n  if (me.status.dvr && window.MediaSource && !me.msefailed && !me.pause) startMSE();\n  else next();\n}\n\n// C4: \"Connecting…\" on the tile's own background while the stream starts;\n// it goes away when the first picture (or the no-signal card) arrives\nfunction showConnecting(on){\n  $(ME).find('.live-connecting').css('display', on ? 'block' : 'none');\n}","old":"function start(){\n  if (me.status.dvr && window.MediaSource && !me.msefailed && !me.pause) startMSE();\n  else next();\n}","patch_id":"p25","time":1793962411823},{"author":"agent","facet":"js","label":"C4: the first frame ends Connecting…","new":"$(ME).find('.live-img').on(\"load\", function(){\n  showConnecting(false);\n  setTimeout(next, 2000);\n});","old":"$(ME).find('.live-img').on(\"load\", function(){\n  setTimeout(next, 2000);\n});","patch_id":"p26","time":1793962429681},{"author":"agent","facet":"js","label":"C4: MSE playback ends Connecting…","new":"  $(ME).find('.live-img').css('display', 'none');\n  $(ME).find('.live-video').css('display', 'block');\n  $(video).off('playing.conn').on('playing.conn', function(){ showConnecting(false); });\n  video.muted = true;","old":"  $(ME).find('.live-img').css('display', 'none');\n  $(ME).find('.live-video').css('display', 'block');\n  video.muted = true;","patch_id":"p27","time":1793962443603},{"author":"agent","facet":"js","label":"C4: settings close refreshes the tile's state","new":"      // C4: the tabs stay; they say what is off. Tell the tile the new state.\n      $(ME).closest('.dvr-wrap').find('.dvr-navbar').css('display', 'block');\n      $(ME).trigger('camera-status', [result.data]);","old":"      $(ME).closest('.dvr-wrap').find('.dvr-navbar').css('display', result.data.dvr ? 'block' : 'none');","patch_id":"p28","time":1793962452237},{"author":"agent","facet":"html","label":"C7: the no-camera sentence","new":"  <div class='live-connecting'>Connecting…</div>\n  <div class='live-nocam'></div>","old":"  <div class='live-connecting'>Connecting…</div>","patch_id":"p29","time":1793962486311},{"author":"agent","facet":"css","label":"C7: no-camera message style","new":"/* C7: \"No camera found on <peer>.\" - a sentence, not a test card */\n.live-wrap .live-nocam {\n  display:none;\n  position:absolute;\n  top:50%;\n  left:0;\n  width:100%;\n  transform:translateY(-50%);\n  text-align:center;\n  padding:0 16px;\n  box-sizing:border-box;\n  color:var(--text);\n}\n\n/* C4: \"Connecting…\" on the tile's own background while the stream starts */\n.live-wrap .live-connecting {","old":"/* C4: \"Connecting…\" on the tile's own background while the stream starts */\n.live-wrap .live-connecting {","patch_id":"p30","time":1793962490255},{"author":"agent","facet":"js","label":"C7: available gates the live view; no camera speaks","new":"  // C7: ask available first - a camera that is not there gets a sentence,\n  // not a test card and a retry loop\n  json(me.prefix+'camera/available', null, function(result){\n    var tree = (result && result.status == 'ok' && result.data) ? result.data : {};\n    for (var k in tree) { waitStatus(); return; }\n    noCamera();\n  });\n};\n\nfunction waitStatus(){\n  if (me.status.device) { start(); return; }\n  json(me.prefix+'camera/status', null, function(result){\n    var peer = ME.DATA.peer;\n    if (result.data) {\n      me.status = ME.DATA = result.data;\n      me.status.peer = peer;\n      start();\n    }\n    else setTimeout(waitStatus, 1000);\n  });\n}\n\n// C7: the no-camera state speaks; no test card, no polling\nfunction noCamera(){\n  showConnecting(false);\n  $(ME).find('.live-img, .live-video').css('display', 'none');\n  var el = $(ME).find('.live-nocam');\n  el.text('No camera found.').css('display', 'block');\n  peerName(function(name){ el.text('No camera found on ' + name + '.'); });\n}\n\n// the viewing instance's own peer list names the peer; local is this machine\nfunction peerName(cb){\n  if (!ME.DATA.peer) { cb('this machine'); return; }\n  json('../peer/peers', null, function(r){\n    var list = (r && r.data && r.data.list) || (r && r.data) || [];\n    for (var i = 0; i < list.length; i++) {\n      var p = list[i];\n      if (p && (p.id == ME.DATA.peer || p.uuid == ME.DATA.peer)) { cb(p.displayname || p.name || ME.DATA.peer); return; }\n    }\n    cb(ME.DATA.peer);\n  });\n}","old":"  if (me.status.device) start();\n  else {\n    json(me.prefix+'camera/status', null, function(result){\n      var peer = ME.DATA.peer;\n      if (result.data) {\n        me.status = ME.DATA = result.data;\n        me.status.peer = peer;\n        start();\n      }\n      else setTimeout(me.ready, 1000);\n    });\n  }\n};","patch_id":"p31","time":1793962498080},{"author":"alex","facet":"js","label":"camera.live: step 0b available error vs empty, backoff retry","new":"  // step 0a: when nothing on this UA can go full screen (iPhone Safari has\n  // no element fullscreen and no video webkitEnterFullscreen), hide the button\n  var fsprobe = $(ME).find('.live-wrap')[0];\n  me.fsSupported = !!(fsprobe.requestFullscreen || fsprobe.webkitRequestFullscreen || $(ME).find('.live-video')[0].webkitEnterFullscreen);\n  if (!me.fsSupported) $(ME).find('.fullscreen-button').css('display', 'none');\n  // C7 / step 0b: ask available first. Only an ok reply with an empty tree\n  // is \"no camera\"; an error or unreachable peer shows its reason and\n  // retries with a backoff, never the test card.\n  checkAvailable(1000);\n};\n\n// step 0b: distinguish ok-but-empty (no camera) from an error reply or an\n// unreachable peer (say why, retry with a growing backoff, not every second)\nfunction checkAvailable(delay){\n  json(me.prefix+'camera/available', null, function(result){\n    if (result && result.status == 'ok') {\n      var tree = result.data || {};\n      for (var k in tree) { waitStatus(); return; }\n      noCamera();\n      return;\n    }\n    cameraError((result && result.msg) ? result.msg : null);\n    var next = Math.min((delay || 1000) * 2, 30000);\n    setTimeout(function(){ checkAvailable(next); }, next);\n  });\n}","old":"  // step 0a: when nothing on this UA can go full screen (iPhone Safari has\n  // no element fullscreen and no video webkitEnterFullscreen), hide the button\n  var fsprobe = $(ME).find('.live-wrap')[0];\n  if (!fsprobe.requestFullscreen && !fsprobe.webkitRequestFullscreen && !$(ME).find('.live-video')[0].webkitEnterFullscreen) {\n    $(ME).find('.fullscreen-button').css('display', 'none');\n  }\n  // C7: ask available first - a camera that is not there gets a sentence,\n  // not a test card and a retry loop\n  json(me.prefix+'camera/available', null, function(result){\n    var tree = (result && result.status == 'ok' && result.data) ? result.data : {};\n    for (var k in tree) { waitStatus(); return; }\n    noCamera();\n  });\n};","patch_id":"p32","time":1793964643160},{"author":"alex","facet":"js","label":"camera.live: step 0d hide full screen with no picture; cameraError","new":"// C7: the no-camera state speaks; no test card, no polling\nfunction noCamera(){\n  showConnecting(false);\n  $(ME).find('.live-img, .live-video').css('display', 'none');\n  // step 0d: no picture, so hide ⛶ (and its exit twin); keep ⚙ so the\n  // camera can still be set up\n  $(ME).find('.fullscreen-button, .fullscreen-exit-button').css('display', 'none');\n  var el = $(ME).find('.live-nocam');\n  el.text('No camera found.').css('display', 'block');\n  peerName(function(name){ el.text('No camera found on ' + name + '.'); });\n}\n\n// step 0b: the camera could not be reached (error reply, peer down). Say\n// why; same no-picture, no-⛶ treatment. The backoff keeps retrying.\nfunction cameraError(reason){\n  showConnecting(false);\n  $(ME).find('.live-img, .live-video').css('display', 'none');\n  $(ME).find('.fullscreen-button, .fullscreen-exit-button').css('display', 'none');\n  var el = $(ME).find('.live-nocam');\n  el.css('display', 'block');\n  if (reason) { el.text(reason); return; }\n  peerName(function(name){ el.text(\"Can't reach \" + name + \".\"); });\n}","old":"// C7: the no-camera state speaks; no test card, no polling\nfunction noCamera(){\n  showConnecting(false);\n  $(ME).find('.live-img, .live-video').css('display', 'none');\n  var el = $(ME).find('.live-nocam');\n  el.text('No camera found.').css('display', 'block');\n  peerName(function(name){ el.text('No camera found on ' + name + '.'); });\n}","patch_id":"p33","time":1793964663564},{"author":"alex","facet":"js","label":"camera.live: restore picture mode when a camera appears after an error","new":"function start(){\n  // a camera was found: back to picture mode (a prior error/no-camera pass\n  // may have hidden the picture and ⛶)\n  $(ME).find('.live-nocam').css('display', 'none');\n  $(ME).find('.live-img').css('display', '');\n  if (me.fsSupported) $(ME).find('.fullscreen-button').css('display', '');\n  showConnecting(true);\n  if (me.status.dvr && window.MediaSource && !me.msefailed && !me.pause) startMSE();\n  else next();\n}","old":"function start(){\n  showConnecting(true);\n  if (me.status.dvr && window.MediaSource && !me.msefailed && !me.pause) startMSE();\n  else next();\n}","patch_id":"p34","time":1793964669562},{"author":"alex","facet":"css","label":"camera.live: C5 dark settings dialog, pinned header/footer, responsive","new":"/* C5: the kit's dark dialog - graphite body and panel-2 header, the same\n   palette as the app's Settings dialog (Applications - gear). The dialog\n   itself is the scroll container capped to the window; its header and the\n   Save footer are sticky, so they stay put and only the middle scrolls.\n   Content-sized width (min, not a fixed 1024px void); stacks under 640px. */\n.camera-settings-popup{\n  display:none;\n  width:min(760px, 92vw);\n  /* vw, not %: the popup kit measures this element while it is briefly\n     position:absolute inside its host (the HUD panel is ~600px wide),\n     then centers it as position:fixed - a %-based width resolves\n     differently in the two states and mis-centers the dialog */\n  max-width:92vw;\n  max-height:calc(100vh - 32px);\n  overflow-y:auto;\n  overflow-x:hidden;\n  background-color:var(--panel);\n  color:var(--text);\n  border:1px solid var(--line);\n  border-radius:var(--border-radius-md);\n}\n\n/* the header pins to the top of the scrolling dialog. It is position:sticky\n   (a positioned element), so the absolute close X still anchors to it. */\n.camera-settings-popup .dialog-header{\n  position:sticky;\n  top:0;\n  z-index:2;\n}\n\n/* Save pins as a footer band at the bottom, always reachable even at\n   1280x600; the body content scrolls behind it */\n.camera-settings-popup .save-camera-settings{\n  position:sticky;\n  bottom:0;\n  z-index:2;\n  display:block;\n  width:100%;\n  box-sizing:border-box;\n  margin:16px 0 0;\n}\n\n/* C5 item 4: under a narrow window, one column with the preview on top.\n   The two settings bodies are 3-column tables (fields | spacer | preview);\n   unfold each row into a column and lift the preview above the fields. */\n@media (max-width: 640px){\n  .camera-settings-popup table,\n  .camera-settings-popup table tbody{ display:block; }\n  .camera-settings-popup table tr{ display:flex; flex-direction:column; }\n  .camera-settings-popup table td{ display:block; width:auto !important; }\n  .camera-settings-popup table td:last-child{ order:-1; }      /* preview on top */\n  .camera-settings-popup table td[width=\"20\"]{ display:none; } /* the spacer */\n  .camera-settings-popup #snapshot,\n  .camera-settings-popup #keyframe{ max-width:100%; margin-bottom:16px; }\n}","old":"/* .upper-right centers against the nearest positioned ancestor - anchor\n   the close X to the dialog header, not the whole 620px dialog */\n.camera-settings-popup .dialog-header{\n  position:relative;\n}\n\n.camera-settings-popup{\n  display:none;\n  width:1024px;\n  /* vw, not %: the popup kit measures this element while it is briefly\n     position:absolute inside its host (the HUD panel is ~600px wide),\n     then centers it as position:fixed - a %-based max-width resolves\n     differently in the two states and mis-centers the dialog */\n  max-width:90vw;\n  height:620px;\n  background-color:white;\n  color:black;\n}","patch_id":"p35","time":1793964798704},{"author":"claude-code","facet":"css","label":"C6: the footer (error line + Save) is the sticky band","new":".camera-settings-popup .dialog-footer{\n  position:sticky;\n  bottom:0;\n  z-index:2;\n  background-color:var(--panel);\n  padding-top:12px;\n  margin-top:16px;\n}\n\n.camera-settings-popup .save-camera-settings{\n  display:block;\n  width:100%;\n  box-sizing:border-box;\n}","old":".camera-settings-popup .save-camera-settings{\n  position:sticky;\n  bottom:0;\n  z-index:2;\n  display:block;\n  width:100%;\n  box-sizing:border-box;\n  margin:16px 0 0;\n}","patch_id":"p36","time":1793967093044},{"author":"claude-code","facet":"js","label":"review: the available backoff stops when the tile is removed","new":"    // stop retrying once this tile has left the page\n    setTimeout(function(){ if (ME.isConnected) checkAvailable(next); }, next);","old":"    setTimeout(function(){ checkAvailable(next); }, next);","patch_id":"p37","time":1793967093054},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> camera.live","new":"[\n{\"claim\": \"camera.live asks camera/available before anything else: only an ok reply with an empty tree means 'No camera found on <peer>.' (no test card, no polling); an error reply or unreachable peer shows its reason and retries on a doubling backoff that stops once the tile leaves the page.\", \"detail\": \"Session 3 C7 + review (2026-11-06). The test card (no_signal.jpg) is kept only for 'the picture stopped': last_keyframe now serves it when the newest keyframe is older than 10 s. With no picture, the full-screen button is hidden and settings stays. Full screen targets the dvr control's .picture-wrap and the icons swap only on fullscreenchange/webkitfullscreenchange, so every exit path (Esc) restores them; iPhone falls back to the video's webkitEnterFullscreen.\", \"tags\": \"camera,live,no-camera,full-screen,C7,C3\", \"source\": {\"lib\": \"camera\", \"ctl\": \"live\", \"facet\": \"js\", \"hash\": \"39126e2c3ae474de\"}, \"confidence\": \"high\", \"time\": 1793967587360},\n{\"end\": true}]\n","old":"","patch_id":"p38","time":1793967591050},{"author":"claude","facet":"js","label":"live: say \"Choose a camera\" when none is set","new":"function start(){\n  // a camera is there but none is chosen yet (never saved, or an old save\n  // wrote \"null\"): say so rather than ask for snapshot?device=null, which\n  // can only answer with the no-signal card\n  var dev = me.status && me.status.device;\n  if (!dev || dev == 'null') { noDevice(); return; }\n  // a camera was found: back to picture mode (a prior error/no-camera pass\n  // may have hidden the picture and ⛶)\n  $(ME).find('.live-nocam').css('display', 'none');","old":"function start(){\n  // a camera was found: back to picture mode (a prior error/no-camera pass\n  // may have hidden the picture and ⛶)\n  $(ME).find('.live-nocam').css('display', 'none');","patch_id":"p39","time":1794154309776},{"author":"claude","facet":"js","label":"live: noDevice state","new":"// cameras are attached but the settings name none: no picture, no ⛶; ⚙\n// stays, since that is where the camera gets chosen\nfunction noDevice(){\n  showConnecting(false);\n  $(ME).find('.live-img, .live-video').css('display', 'none');\n  $(ME).find('.fullscreen-button, .fullscreen-exit-button').css('display', 'none');\n  $(ME).find('.live-nocam').text('Choose a camera in ⚙.').css('display', 'block');\n}\n\n// step 0b: the camera could not be reached (error reply, peer down). Say","old":"// step 0b: the camera could not be reached (error reply, peer down). Say","patch_id":"p40","time":1794154315046}]},"id":"twupjw18452a5ad95s2e7_patches","readers":[],"time":1794154315046,"username":"system","writers":[]}