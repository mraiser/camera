{"data":{"list":[{"author":"claude","facet":"js","label":"dvr: events tab uses events_page with fallback","new":"$(ME).find('.tab-events').click(function(){\n    $(ME).find('.snap-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');\n    var div = $(ME).find('.event-images');\n    div.empty();\n    var render = function(result){\n      if (!result.data) return;\n      result.data.sort(function(a,b){\n        return a.time - b.time;\n      });\n      for (var i in result.data) {\n        var d = result.data[i];\n        var date = new Date(d.time);\n        var start = d.time - 2000;\n        var stop = d.frames[d.frames.length - 1].time + 2000;\n        var el = $('<div class=\"thumbnail-wrap\" data-start=\"'+start+'\" data-stop=\"'+stop+'\"><img class=\"thumbnail\" src=\"'+me.prefix+'camera'+d.jpg+'\"><div class=\"thumbnail-timestamp\">'+parseTime(date)+'</div></div>');\n        el.click(showClip);\n        div.append(el);\n      }\n      adjustSizes();\n    };\n    // newest 500 via events_page; an older host (over the peer proxy)\n    // lacks it, so fall back to the unpaginated events command\n    json(me.prefix+'camera/events_page', \"since=0&limit=500\", function(result){\n      if (result.status == 'ok' && result.data) render(result);\n      else json(me.prefix+'camera/events', null, render);\n    });\n  });\n  \n  ","old":"$(ME).find('.tab-events').click(function(){\n    $(ME).find('.snap-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');\n    var div = $(ME).find('.event-images');\n    div.empty();\n    json(me.prefix+'camera/events', null, function(result){\n      result.data.sort(function(a,b){\n        return a.time - b.time;\n      });\n      for (var i in result.data) {\n        var d = result.data[i];\n        var date = new Date(d.time);\n        var start = d.time - 2000;\n        var stop = d.frames[d.frames.length - 1].time + 2000;\n        var el = $('<div class=\"thumbnail-wrap\" data-start=\"'+start+'\" data-stop=\"'+stop+'\"><img class=\"thumbnail\" src=\"'+me.prefix+'camera'+d.jpg+'\"><div class=\"thumbnail-timestamp\">'+parseTime(date)+'</div></div>');\n        el.click(showClip);\n        div.append(el);\n      }\n      adjustSizes();\n    });\n  });\n  \n  ","patch_id":"p1","time":1786470829294},{"author":"claude","facet":"js","label":"dvr: no time picker on an empty archive","new":"function buildTimePicker(){\n  // an empty archive has no first/last - a picker built from them would\n  // emit timestamp=NaN requests forever\n  if (!me.status.first || !me.status.last) { return; }\n  var start = new Date(me.status.first);","old":"function buildTimePicker(){\n  var start = new Date(me.status.first);","patch_id":"p2","time":1786472532929},{"author":"claude","facet":"js","label":"dvr: guard thumbnail strip against NaN time","new":"function buildThumbs(){\n  if (!me.dvrtime || isNaN(me.dvrtime)) { return; }\n  var start = me.dvrstart = me.dvrtime;","old":"function buildThumbs(){\n  var start = me.dvrstart = me.dvrtime;","patch_id":"p3","time":1786472533139},{"author":"claude","facet":"js","label":"dvr: guard snap load against NaN time","new":"me.loadSnap = function(time, cb){\n  if (!time || isNaN(time)) { if (cb) cb(); return; }\n  var url","old":"me.loadSnap = function(time, cb){\n  var url","patch_id":"p4","time":1786472533348}]},"id":"ojszgo184528b25c3yf4_patches","readers":[],"time":1786472533348,"username":"system","writers":[]}