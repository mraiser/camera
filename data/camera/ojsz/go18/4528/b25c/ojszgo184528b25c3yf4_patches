resw+'px');\n  \n  if (me.status.dvr) {\n    $(ME).find('.dvr-navbar').css('display', 'block');\n  }\n  else {\n    $(ME).find('.dvr-navbar').css('display', 'none');\n  }\n}","patch_id":"p15","time":1793959538508},{"author":"agent","facet":"js","label":"C3: ResizeObserver on the tile replaces the leaking window.resize handler","new":"// C3: refit from the tile's own box (dragging the Peers panel never fires\n// window.resize, and window handlers piled up one per remount). One\n// observer per mount; it drops itself when the tile leaves the page.\nme.sizer = new ResizeObserver(function(){\n  if (!ME.isConnected) { me.sizer.disconnect(); return; }\n  adjustSizes();\n});\nme.sizer.observe(ME);","old":"$(window).resize(adjustSizes);\n//console.log($(ME).width()+\"x\"+$(ME).height()+\", \"+me.status.resolution);","patch_id":"p16","time":1793959545008},{"author":"agent","facet":"js","label":"C3: the gear/fullscreen bar stays on the picture in the DVR tab","new":"    buildTimePicker();\n    $(ME).find('.video-wrap').css('display', 'none');","old":"    buildTimePicker();\n    $(ME).find('.video-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');","patch_id":"p17","time":1793959551231},{"author":"agent","facet":"js","label":"C3: the gear/fullscreen bar no longer toggles on the LIVE tab","new":"    $(ME).find('.video-wrap').css('display', 'none');","old":"    $(ME).find('.video-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'block');","patch_id":"p18","time":1793959556941},{"author":"agent","facet":"js","label":"C3: the gear/fullscreen bar stays on the picture in the EVENTS tab","new":"    $(ME).find('.snap-wrap').css('display', 'none');\n    var div = $(ME).find('.event-images');","old":"    $(ME).find('.snap-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');\n    var div = $(ME).find('.event-images');","patch_id":"p19","time":1793959562514}]},"id":"ojszgo184528b25c