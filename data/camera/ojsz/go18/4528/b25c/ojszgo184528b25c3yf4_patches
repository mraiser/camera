urn it on in ⚙ Settings.').css('display', 'block');\n    $(ME).find('.dvr-images').css('display', 'none');\n    ctl.css('display', 'none');\n    return;\n  }\n  var empty = !me.status.first || !me.status.last;\n  ctl.css('display', 'block');\n  $(ME).find('.dvr-pickers, .dvr-duration').css('display', empty ? 'none' : 'inline-block');\n  $(ME).find('.dvrplaybutton, .dvrdownloadbutton').prop('disabled', empty);\n  $(ME).find('.dvr-images').css('display', empty ? 'none' : 'block');\n  if (empty) {\n    msg.text('No recordings yet.').css('display', 'block');\n    $(ME).find('.download_selected').removeAttr('href');\n  }\n  else {\n    msg.css('display', 'none');\n    buildTimePicker();\n  }\n}\n\n// the live control announces fresh status when the settings dialog closes\n$(ME).on('camera-status', function(e, status){\n  if (status) me.status = status;\n  adjustSizes();\n  if ($(ME).find('.navbar-tab.selected').data('id') == 'cam-dvr') renderDvrTab();\n});","old":"$(ME).find('.dvrplaybutton').click(function(){\n  play(me.dvrstart, me.dvrstop);\n});","patch_id":"p34","time":1793962427181},{"author":"agent","facet":"css","label":"C4: kit-styled selects, disabled buttons","new":"/* C4: ▶ and ⬇ read as disabled when there is nothing to play */\n.dvr-wrap .dvr-controls button[disabled]{\n  opacity:.45;\n  cursor:default;\n}","old":".dvr-wrap .timeselect select{\n  background-color:black;\n  color: white;\n}","patch_id":"p35","time":1793962437204},{"author":"agent","facet":"js","label":"C4: the tab bar always shows","new":"  $(ME).find('.picture-wrap').css('aspect-ratio', resw + ' / ' + resh);\n  // C4: the tabs always show; the DVR tab itself says when DVR is off\n  $(ME).find('.dvr-navbar').css('display', 'block');","old":"  $(ME).find('.picture-wrap').css('aspect-ratio', resw + ' / ' + resh);\n  $(ME).find('.dvr-navbar').css('display', me.status.dvr ? 'block' : 'none');","patch_id":"p36","time":1793962440619},{"author":"agent","facet":"css","label":"step 0b: the picker row 