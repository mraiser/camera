{"data":{"list":[{"author":"claude","facet":"js","label":"dvr: events tab uses events_page with fallback","new":"$(ME).find('.tab-events').click(function(){\n    $(ME).find('.snap-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');\n    var div = $(ME).find('.event-images');\n    div.empty();\n    var render = function(result){\n      if (!result.data) return;\n      result.data.sort(function(a,b){\n        return a.time - b.time;\n      });\n      for (var i in result.data) {\n        var d = result.data[i];\n        var date = new Date(d.time);\n        var start = d.time - 2000;\n        var stop = d.frames[d.frames.length - 1].time + 2000;\n        var el = $('<div class=\"thumbnail-wrap\" data-start=\"'+start+'\" data-stop=\"'+stop+'\"><img class=\"thumbnail\" src=\"'+me.prefix+'camera'+d.jpg+'\"><div class=\"thumbnail-timestamp\">'+parseTime(date)+'</div></div>');\n        el.click(showClip);\n        div.append(el);\n      }\n      adjustSizes();\n    };\n    // newest 500 via events_page; an older host (over the peer proxy)\n    // lacks it, so fall back to the unpaginated events command\n    json(me.prefix+'camera/events_page', \"since=0&limit=500\", function(result){\n      if (result.status == 'ok' && result.data) render(result);\n      else json(me.prefix+'camera/events', null, render);\n    });\n  });\n  \n  ","old":"$(ME).find('.tab-events').click(function(){\n    $(ME).find('.snap-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');\n    var div = $(ME).find('.event-images');\n    div.empty();\n    json(me.prefix+'camera/events', null, function(result){\n      result.data.sort(function(a,b){\n        return a.time - b.time;\n      });\n      for (var i in result.data) {\n        var d = result.data[i];\n        var date = new Date(d.time);\n        var start = d.time - 2000;\n        var stop = d.frames[d.frames.length - 1].time + 2000;\n        var el = $('<div class=\"thumbnail-wrap\" data-start=\"'+start+'\" data-stop=\"'+stop+'\"><img class=\"thumbnail\" src=\"'+me.prefix+'camera'+d.jpg+'\"><div class=\"thumbnail-timestamp\">'+parseTime(date)+'</div></div>');\n        el.click(showClip);\n        div.append(el);\n      }\n      adjustSizes();\n    });\n  });\n  \n  ","patch_id":"p1","time":1786470829294},{"author":"claude","facet":"js","label":"dvr: no time picker on an empty archive","new":"function buildTimePicker(){\n  // an empty archive has no first/last - a picker built from them would\n  // emit timestamp=NaN requests forever\n  if (!me.status.first || !me.status.last) { return; }\n  var start = new Date(me.status.first);","old":"function buildTimePicker(){\n  var start = new Date(me.status.first);","patch_id":"p2","time":1786472532929},{"author":"claude","facet":"js","label":"dvr: guard thumbnail strip against NaN time","new":"function buildThumbs(){\n  if (!me.dvrtime || isNaN(me.dvrtime)) { return; }\n  var start = me.dvrstart = me.dvrtime;","old":"function buildThumbs(){\n  var start = me.dvrstart = me.dvrtime;","patch_id":"p3","time":1786472533139},{"author":"claude","facet":"js","label":"dvr: guard snap load against NaN time","new":"me.loadSnap = function(time, cb){\n  if (!time || isNaN(time)) { if (cb) cb(); return; }\n  var url","old":"me.loadSnap = function(time, cb){\n  var url","patch_id":"p4","time":1786472533348},{"author":"Newbound","facet":"js","label":"Fix video resize in HUD by calling adjustSizes on play","new":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  $(ME).find('.video-wrap-video').prop('src', url);\n  $(ME).find('.video-wrap').css('display', 'block');\n  adjustSizes();\n}","old":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  $(ME).find('.video-wrap-video').prop('src', url);\n  $(ME).find('.video-wrap').css('display', 'block');\n}","patch_id":"p5","time":1786883226802},{"author":"Newbound","facet":"js","label":"Fix video resize: wait for loadedmetadata before showing video and calling adjustSizes","new":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  var el = $(ME).find('.video-wrap-video');\n  el[0].pause();\n  el[0].removeAttribute('src');\n  el[0].load();\n  el[0].src = url;\n  \n  // Wait for video metadata to load before showing and resizing\n  el.off('loadedmetadata');\n  el.on('loadedmetadata', function() {\n    $(ME).find('.video-wrap').css('display', 'block');\n    adjustSizes();\n  });\n}","old":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  $(ME).find('.video-wrap-video').prop('src', url);\n  $(ME).find('.video-wrap').css('display', 'block');\n  adjustSizes();\n}","patch_id":"p6","time":1786883726105},{"author":"Newbound","facet":"js","label":"Trigger resize event on .live-video after video metadata loads","new":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  var el = $(ME).find('.video-wrap-video');\n  el[0].pause();\n  el[0].removeAttribute('src');\n  el[0].load();\n  el[0].src = url;\n  \n  // Wait for video metadata to load before showing and resizing\n  el.off('loadedmetadata');\n  el.on('loadedmetadata', function() {\n    $(ME).find('.video-wrap').css('display', 'block');\n    adjustSizes();\n    // Trigger resize event on .live-video to ensure proper sizing in HUD\n    $('.live-video').resize();\n  });\n}","old":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  var el = $(ME).find('.video-wrap-video');\n  el[0].pause();\n  el[0].removeAttribute('src');\n  el[0].load();\n  el[0].src = url;\n  \n  // Wait for video metadata to load before showing and resizing\n  el.off('loadedmetadata');\n  el.on('loadedmetadata', function() {\n    $(ME).find('.video-wrap').css('display', 'block');\n    adjustSizes();\n  });\n}","patch_id":"p7","time":1786883993524},{"author":"agent","facet":"css","label":"C1: scope every rule under .dvr-wrap; scrollbar styling only on the thumbnail strips, kit colours","new":".dvr-wrap, .dvr-wrap .img-wrap, .dvr-wrap .video-wrap-video {\n  width:100%;\n  height:100%;\n  position:relative;\n  margin-left:auto;\n  margin-right:auto;\n}\n\n.dvr-wrap .snap-wrap, .dvr-wrap .video-wrap {\n  display:none;\n  position:absolute;\n  top:0px;\n  left:0px;\n  width:100%;\n  height:100%;\n  text-align:center;\n}\n\n.dvr-wrap .dvr-navbar {\n  background-color:black;\n}\n\n.dvr-wrap .event-images, .dvr-wrap .dvr-images {\n  position:relative;\n  height:110px;\n  width:100%;\n  background-color:#222;\n  white-space:nowrap;\n  overflow-x:scroll;\n  overflow-y:hidden;\n}\n\n/* the thumbnail strips' own thin scrollbar, never the page's (C1) */\n.dvr-wrap .event-images::-webkit-scrollbar, .dvr-wrap .dvr-images::-webkit-scrollbar {\n  background: transparent;\n  height: 10px;\n}\n\n.dvr-wrap .event-images::-webkit-scrollbar-thumb, .dvr-wrap .dvr-images::-webkit-scrollbar-thumb {\n  background: var(--line);\n  border-radius: 5px;\n}\n\n.dvr-wrap .thumbnail-wrap {\n  display:inline-block;\n  height: 96px;\n  width:auto;\n  position:relative;\n  margin:1px;\n  border:1px white solid;\n}\n\n.dvr-wrap .thumbnail {\n  height: 96px;\n}\n\n.dvr-wrap .thumbnail-timestamp {\n  color:#83bc00;\n  font-size:small;\n  position:absolute;\n  bottom:10px;\n  left:10px;\n  text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;\n}\n\n.dvr-wrap .tab-content, .dvr-wrap .tab-content