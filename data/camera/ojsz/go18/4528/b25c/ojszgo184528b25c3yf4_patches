il-wrap\" data-start=\"'+start+'\" data-stop=\"'+stop+'\"><img class=\"thumbnail\" src=\"'+me.prefix+'camera'+d.jpg+'\"><div class=\"thumbnail-timestamp\">'+parseTime(date)+'</div></div>');\n        el.click(showClip);\n        div.append(el);\n      }\n      adjustSizes();\n    });\n  });\n  \n  ","patch_id":"p1","time":1786470829294},{"author":"claude","facet":"js","label":"dvr: no time picker on an empty archive","new":"function buildTimePicker(){\n  // an empty archive has no first/last - a picker built from them would\n  // emit timestamp=NaN requests forever\n  if (!me.status.first || !me.status.last) { return; }\n  var start = new Date(me.status.first);","old":"function buildTimePicker(){\n  var start = new Date(me.status.first);","patch_id":"p2","time":1786472532929},{"author":"claude","facet":"js","label":"dvr: guard thumbnail strip against NaN time","new":"function buildThumbs(){\n  if (!me.dvrtime || isNaN(me.dvrtime)) { return; }\n  var start = me.dvrstart = me.dvrtime;","old":"function buildThumbs(){\n  var start = me.dvrstart = me.dvrtime;","patch_id":"p3","time":1786472533139},{"author":"claude","facet":"js","label":"dvr: guard snap load against NaN time","new":"me.loadSnap = function(time, cb){\n  if (!time || isNaN(time)) { if (cb) cb(); return; }\n  var url","old":"me.loadSnap = function(time, cb){\n  var url","patch_id":"p4","time":1786472533348},{"author":"Newbound","facet":"js","label":"Fix video resize in HUD by calling adjustSizes on play","new":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  $(ME).find('.video-wrap-video').prop('src', url);\n  $(ME).find('.video-wrap').css('display', 'block');\n  adjustSizes();\n}","old":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  $(ME).find('.video-wrap-video').prop('src', url);\n  $(ME).find('.video-wrap').css('display', 'block');\n}","patch_id":"p5","time":1786883226802},{"author":"Newbound","facet":"js","label":"Fix video resize: wait for loadedmetadata before showing video and calling adjustSizes","new":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  var el = $(ME).find('.video-wrap-video');\n  el[0].pause();\n  el[0].removeAttribute('src');\n  el[0].load();\n  el[0].src = url;\n  \n  // Wait for video metadata to load before showing and resizing\n  el.off('loadedmetadata');\n  el.on('loadedmetadata', function() {\n    $(ME).find('.video-wrap').css('display', 'block');\n    adjustSizes();\n  });\n}","old":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  $(ME).find('.video-wrap-video').prop('src', url);\n  $(ME).find('.video-wrap').css('display', 'block');\n  adjustSizes();\n}","patch_id":"p6","time":1786883726105},{"author":"Newbound","facet":"js","label":"Trigger resize event on .live-video after video metadata loads","new":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'+stop+'.mp4';\n  me.live.pause = true;\n  var el = $(ME).find('.video-wrap-video');\n  el[0].pause();\n  el[0].removeAttribute('src');\n  el[0].load();\n  el[0].src = url;\n  \n  // Wait for video metadata to load before showing and resizing\n  el.off('loadedmetadata');\n  el.on('loadedmetadata', function() {\n    $(ME).find('.video-wrap').css('display', 'block');\n    adjustSizes();\n    // Trigger resize event on .live-video to ensure proper sizing in HUD\n    $('.live-video').resize();\n  });\n}","old":"function play(start, stop) {\n  $(ME).find('.snap-wrap').css('display', 'none');\n  var url = me.prefix+'camera/play/'+start+'_'