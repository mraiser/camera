play:inline-block;\n  text-align:left;\n  margin-left:10px;\n  margin-right:10px;\n  margin-top:10px;\n}\n\n.dvr-wrap .durationslidervalue{\n  color:black;\n  width:40px;\n}\n\n.dvr-wrap .durationsliderlable{\n  margin-bottom:4px;\n}","patch_id":"p14","time":1793959526270},{"author":"agent","facet":"js","label":"C3: adjustSizes sets the picture ratio instead of measuring; no-op before status","new":"function adjustSizes(){\n  // C3: a fit before camera/status answers is a no-op, never an error\n  if (!me.status) return;\n  var res = me.status.resolution;\n  if (typeof res == \"string\") res = res.split(\"x\");\n  else if (!res) res = ['1920','1080'];\n  var resw = parseInt(res[0]);\n  var resh = parseInt(res[1]);\n  if (!(resw > 0) || !(resh > 0)) { resw = 1920; resh = 1080; }\n  // rotation turns the frames portrait; the picture box follows them\n  var rot = parseInt(me.status.rotation);\n  if (rot == 90 || rot == 270) { var t = resw; resw = resh; resh = t; }\n  // pure CSS does the fit: full tile width at the picture's own ratio,\n  // whatever order the first fit and the live install happen in\n  $(ME).find('.picture-wrap').css('aspect-ratio', resw + ' / ' + resh);\n  $(ME).find('.dvr-navbar').css('display', me.status.dvr ? 'block' : 'none');\n}","old":"function adjustSizes(){\n  var res = me.status.resolution;\n  if (res) {\n    if (typeof res == \"string\")\n      res = res.split(\"x\");\n  }\n  else res = me.status.resolution = ['1920','1080'];\n  var resw = parseInt(res[0]);\n  var resh = parseInt(res[1]);\n  var r = resw / resh;\n  \n  var navh = me.status.dvr ? $(ME).find('.dvr-navbar').height() : 0;\n  \n  var allh = $(ME).height() - navh;\n  var allw = $(ME).width();\n\n  if (resh > allh) {\n    resw = allh * r;\n    resh = allh;\n    allw = Math.min(allw, resw);\n  }\n\n  if (resw > allw) {\n    resh = allw / r;\n    resw = allw;\n    allh = resh;\n  }\n  \n  $(ME).find('.dvr-wrap').css('height', ''+resh+'px');\n  $(ME).find('.imgwidth').css('width', ''+resw+'px');\n  \n  if (me.status.dvr) {\n    $(ME).find('.dvr-navbar').css('display', 'block');\n  }\n  else {\n    $(ME).find('.dvr-navbar').css('display', 'none');\n  }\n}","patch_id":"p15","time":1793959538508},{"author":"agent","facet":"js","label":"C3: ResizeObserver on the tile replaces the leaking window.resize handler","new":"// C3: refit from the tile's own box (dragging the Peers panel never fires\n// window.resize, and window handlers piled up one per remount). One\n// observer per mount; it drops itself when the tile leaves the page.\nme.sizer = new ResizeObserver(function(){\n  if (!ME.isConnected) { me.sizer.disconnect(); return; }\n  adjustSizes();\n});\nme.sizer.observe(ME);","old":"$(window).resize(adjustSizes);\n//console.log($(ME).width()+\"x\"+$(ME).height()+\", \"+me.status.resolution);","patch_id":"p16","time":1793959545008},{"author":"agent","facet":"js","label":"C3: the gear/fullscreen bar stays on the picture in the DVR tab","new":"    buildTimePicker();\n    $(ME).find('.video-wrap').css('display', 'none');","old":"    buildTimePicker();\n    $(ME).find('.video-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');","patch_id":"p17","time":1793959551231},{"author":"agent","facet":"js","label":"C3: the gear/fullscreen bar no longer toggles on the LIVE tab","new":"    $(ME).find('.video-wrap').css('display', 'none');","old":"    $(ME).find('.video-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'block');","patch_id":"p18","time":1793959556941},{"author":"agent","facet":"js","label":"C3: the gear/fullscreen bar stays on the picture in the EVENTS tab","new":"    $(ME).find('.snap-wrap').css('display', 'none');\n    var div = $(ME).find('.event-images');","old":"    $(ME).find('.snap-wrap').css('display', 'none');\n    $(ME).find('.live-img-ctrls').css('display', 'none');\n    var div = $(ME).find('.event-images');","patch_id":"p19","time":1793959562514},{"author":"agent","facet