indSliderValue(sel, out){\n    var s = $(ME).find(sel), o = $(ME).find(out);\n    var paint = function(){ o.text(s.val() + ' / ' + s.attr('max')); };\n    s.on('input', paint);\n    paint();\n  }\n  bindSliderValue('.rvs-sense', '.rvs-sense-value');\n  bindSliderValue('.rvs-noise', '.rvs-noise-value');\n\n  $(ME).find('#camera-settings-go-here').html('');","old":"  document.body.api.ui.initSliders(ME);\n  $(ME).find('#camera-settings-go-here').html('');","patch_id":"p7","time":1793964823062},{"author":"alex","facet":"css","label":"camera.dvr_settings: C9 slider value readout style","new":".rvs-sense, .rvs-noise {\n  width:100% !important;\n}\n\n/* C9: the current slider value, beside its label */\n.sliderval {\n  color:var(--text);\n  letter-spacing:normal;\n  font-weight:600;\n  margin-left:6px;\n}","old":".rvs-sense, .rvs-noise {\n  width:100% !important;\n}","patch_id":"p8","time":1793964831126},{"author":"claude-code","facet":"html","label":"C6: camera and recording sections always shown; class-based switches (no duplicate ids); footer with error line","new":"<div class='cam-section'>\n  <div class='section-title'>Camera</div>\n  <div class='section-note cam-restart-note'>Saving restarts recording.</div>\n  <div class='camera-settings-go-here'></div>\n</div>\n<hr>\n<div class='rec-section'>\n  <div class='section-title'>Recording</div>\n  <label class='switchrow'>\n    <div class=\"switch\">\n      <input type=\"checkbox\" class=\"switch-input dvr-switch\" />\n      <span class=\"switch-label\"></span>\n    </div>\n    DVR\n  </label>\n  <div class='rec-fields'>\n    <div class='textinputlabel'>Storage Directory</div>\n    <input type='text' class='textinput storagedir' placeholder='Path to storage directory'>\n    <div class='textinputlabel'>Frame Rate</div>\n    <select class='textinput select-fps'>\n      <option>30</option>\n      <option>25</option>\n      <option>20</option>\n      <option>15</option>\n      <option>10</option>\n      <option>5</option>\n    </select>\n    <label class='switchrow'>\n      <div class=\"switch\">\n        <input type=\"checkbox\" class=\"switch-input motion-switch\" />\n        <span class=\"switch-label\"></span>\n      </div>\n      Detect Motion\n    </label>\n    <div class='motion-settings'>\n      <div class='longselect'>\n        <div class='textinputlabel bottomspace'>Sensitivity <span class='sliderval rvs-sense-value'></span></div>\n        <input class=\"plainslider rvs-sense\" type=\"range\"  min=\"0\" max=\"11\" value=\"0\" tabindex=\"0\">\n      </div>\n      <br>\n      <div class='longselect'>\n        <div class='textinputlabel bottomspace'>Noise Cancellation <span class='sliderval rvs-noise-value'></span></div>\n        <input class=\"plainslider rvs-noise\" type=\"range\"  min=\"0\" max=\"11\" value=\"0\" tabindex=\"0\">\n      </div>\n    </div>\n  </div>\n</div>\n<div class='dialog-footer'>\n  <div class='save-error'></div>\n  <button class='coloredbutton save-camera-settings'>Save</button>\n</div>","old":"<i class='hideme camera-settings-button'>Turn DVR off and save to edit camera settings</i>\n<div id='camera-settings-go-here'></div>\n<hr>\n<br>\n<table border='0' cellpadding='0' cellspacing='0' width='100%'>\n  <tr>\n    <td width='280' style='vertical-align:top;'>\n      <label for=\"dvr-switch\">\n        <div class=\"switch\">\n          <input id=\"dvr-switch\" type=\"checkbox\" class=\"switch-input\" />\n          <span class=\"switch-label\"></span>\n        </div>\n        DVR\n      </label>\n      <br><br>\n      <div class='dvr-settings-go-here hideme' style='white-space:nowrap;'>\n        <div class='textinputlabel'>Storage Directory</div>\n        <input type='text' class='textinput storagedir' placeholder='Path to storage directory'>\n        <br><br>\n        <div class='textinputlabel'>Select Frame Rate</div>\n        <select name='select-fps' class='textinput' id='select-fps'>\n          <option>30</option>\n          <option>25</option>\n          <option>20</option>\n          <option>15</option>\n          <option>10</option>\n          <option>5</option>\n        </select> \n        <br><br>\n        <label for=\"motion-switch\">\n          <div class=\"switch\">\n            <input id=\"motion-switch\" type=\"checkbox\" class=\"switch-input\" />\n            <span class=\"switch-label\"></span>\n          </div>\n          Detect Motion\n        </label>\n        <br><br>\n        <div class='hideme padsides motion-settings'>\n          <div class='longselect'>\n            <div class='textinputlabel bottomspace'>Sensitivity <span class='sliderval rvs-sense-value'></span></div>\n            <input class=\"plainslider rvs-sense\" type=\"range\"  min=\"0\" max=\"11\" value=\"0\" tabindex=\"0\">\n          </div>\n          <br>\n          <div class='longselect'>\n            <div class='textinputlabel bottomspace'>Noise Cancellation <span class='sliderval rvs-noise-value'></span></div>\n            <input class=\"plainslider rvs-noise\" type=\"range\"  min=\"0\" max=\"11\" value=\"0\" tabindex=\"0\">\n          </div>\n          <br>\n        </div>\n      </div>\n    </td>\n    <td width='20'></td>\n    <td style='vertical-align:top;'>\n      <img id=\"keyframe\" class=\"hideme\">\n      <br><br>\n    </td>\n  </tr>\n</table>\n<i class='hideme dvr-settings-message'>\n  Turn DVR on and save to edit DVR settings\n  <br><br>\n</i>\n<div class='hide-on-cam hideme'><hr><br></div>\n<button class='coloredbutton save-camera-settings'>Save</button>\n","patch_id":"p9","time":1793967065308},{"author":"claude-code","facet":"js","label":"C6: both sections, DVR switch acts before Save, Save sends storage and only real values, failed save shown in footer","new":"var me = this; \nvar ME = $('#'+me.UUID)[0];\n\nme.ready = function(){\n  if (!ME.DATA.peer) me.prefix = \"../\";\n  else me.prefix = \"../peer/remote/\"+ME.DATA.peer+\"/\";\n  \n  document.body.api.ui.initSliders(ME);\n\n  // C9: \"value / max\" beside each motion slider, live while dragging. Bound\n  // before the load trigger('input') below so the first paint is correct.\n  function bindSliderValue(sel, out){\n    var s = $(ME).find(sel), o = $(ME).find(out);\n    var paint = function(){ o.text(s.val() + ' / ' + s.attr('max')); };\n    s.on('input', paint);\n    paint();\n  }\n  bindSliderValue('.rvs-sense', '.rvs-sense-value');\n  bindSliderValue('.rvs-noise', '.rvs-noise-value');\n\n  // C6: the dialog is mounted fresh on every open, so every open asks the\n  // camera for its current settings; both sections always show\n  json(me.prefix+'camera/settings', null, function(result) {\n    me.settings = (result && result.data) ? result.data : {};\n    $(ME).find('.rvs-sense').val(me.settings.motion_sensitivity).trigger(\"input\");\n    $(ME).find('.rvs-noise').val(me.settings.motion_noise_cancel).trigger(\"input\");\n    $(ME).find('.dvr-switch').prop('checked', !!me.settings.dvr);\n    $(ME).find('.motion-switch').prop('checked', !!me.settings.motion);\n    $(ME).find('.storagedir').val(me.settings.storage);\n    $(ME).find('.select-fps').val(me.settings.framerate);\n    showRecording();\n    var cs = $.extend({}, me.settings, { peer: ME.DATA.peer });\n    installControl($(ME).find('.camera-settings-go-here')[0], 'camera', 'camera_settings', function(api){}, cs);\n  });\n};\n\n// C6: flipping DVR shows its effect at once, before Save - the recording\n// fields dim, and the Camera section says a save restarts recording\n// (settings.rs stops and restarts the capture on every save with DVR on)\nfunction showRecording(){\n  var on = $(ME).find('.dvr-switch').prop('checked');\n  var fields = $(ME).find('.rec-fields');\n  fields.toggleClass('dimmed', !on);\n  fields.find('input, select').prop('disabled', !on);\n  $(ME).find('.cam-restart-note').css('display', on ? 'block' : 'none');\n  $(ME).find('.motion-settings').css('display', $(ME).find('.motion-switch').prop('checked') ? 'block' : 'none');\n}\n$(ME).find('.dvr-switch, .motion-switch').on('change', showRecording);\n\n// C6: a failed save says why in the footer and keeps the dialog open. The\n// reply can fail at the top (peer unreachable) or inside (the command's own\n// {status:err} wrapped as data)\nfunction saveError(r){\n  if (!r) return \"Couldn't save: no reply from the camera.\";\n  if (r.status != 'ok') return \"Couldn't save: \" + (r.msg || \"the camera didn't accept the settings.\");\n  if (r.data && r.data.status == 'err') return \"Couldn't save: \" + (r.data.msg || \"the camera didn't accept the settings.\");\n  return null;\n}\n\n$(ME).find('.save-camera-settings').click(function(){\n  var btn = $(this);\n  var d = {};\n  // only real values: a field that isn't there (no camera) must not\n  // overwrite the stored setting with null\n  function put(k, v){ if (v !== undefined && v !== null && v !== '') d[k] = v; }\n  put('camera', $(ME).find('#select-camera').val());\n  put('device', $(ME).find('#select-device').val());\n  put('format', $(ME).find('#select-format').val());\n  put('resolution', $(ME).find('#select-resolution').val());\n  put('rotation', $(ME).find('#select-rotation').val());\n  put('storage', $.trim($(ME).find('.storagedir').val() || ''));\n  put('framerate', $(ME).find('.select-fps').val());\n  put('motion_sensitivity', $(ME).find('.rvs-sense').val());\n  put('motion_noise_cancel', $(ME).find('.rvs-noise').val());\n  d.dvr = $(ME).find('.dvr-switch').prop('checked');\n  d.motion = $(ME).find('.motion-switch').prop('checked');\n  d.recording = d.dvr;\n  var errline = $(ME).find('.save-error').css('display', 'none');\n  btn.prop('disabled', true);\n  json(me.prefix+'camera/settings', \"settings=\"+encodeURIComponent(JSON.stringify(d)), function(result) {\n    btn.prop('disabled', false);\n    var err = saveError(result);\n    if (err) { errline.text(err).css('display', 'block'); return; }\n    $(ME).closest('.settings-popup').find('.close-camera-settings').click();\n  });\n});","old":"var me = this; \nvar ME = $('#'+me.UUID)[0];\n\nme.ready = function(){\n  if (!ME.DATA.peer) me.prefix = \"../\";\n  else me.prefix = \"../peer/remote/\"+ME.DATA.peer+\"/\";\n  \n  document.body.api.ui.initSliders(ME);\n\n  // C9: \"value / max\" beside each motion slider, live while dragging. Bound\n  // before the load trigger('input') below so the first paint is correct.\n  function bindSliderValue(sel, out){\n    var s = $(ME).find(sel), o = $(ME).find(out);\n    var paint = function(){ o.text(s.val() + ' / ' + s.attr('max')); };\n    s.on('input', paint);\n    paint();\n  }\n  bindSliderValue('.rvs-sense', '.rvs-sense-value');\n  bindSliderValue('.rvs-noise', '.rvs-noise-value');\n\n  $(ME).find('#camera-settings-go-here').html('');\n  json(me.prefix+'camera/settings', null, function(result) {\n    if (result.data) {\n      me.settings = result.data;\n      $(ME).find('.rvs-sense').val(me.settings.motion_sensitivity).trigger(\"input\");\n      $(ME).find('.rvs-noise').val(me.settings.motion_noise_cancel).trigger(\"input\");\n      $(ME).find('#dvr-switch').prop('checked', me.settings.dvr);\n      $(ME).find('#motion-switch').prop('checked', me.settings.motion);\n      $(ME).find('.storagedir').val(me.settings.storage);\n      $(ME).find('#select-fps').val(me.settings.framerate);\n    }\n    else me.settings = {};\n    \n    if (me.settings.dvr) {\n      $(ME).find('.camera-settings-button').css('display', 'block');\n      $(ME).find('.dvr-settings-go-here').css('display', 'block');\n      $(ME).find('.hide-on-cam').css('display', 'block');\n      if (me.settings.motion) {\n        $(ME).find('.motion-settings').css('display', 'block');\n      }\n      $(ME).find('#keyframe').css('display', 'block');\n      keyFrame();\n    }\n    else {\n      $(ME).find('.dvr-settings-message').css('display', 'block');\n      me.settings.peer = ME.DATA.peer;\n      installControl($(ME).find('#camera-settings-go-here')[0], 'camera', 'camera_settings', function(api){}, me.settings);\n    }\n  });\n};\n\nvar q = 0;\nfunction keyFrame() {\n  if (me.settings.dvr) {\n    $(ME).find('#keyframe').prop(\"src\", me.prefix+\"camera/last_keyframe/y\"+(q++)+\".jpg\");\n  }\n}\n\n$(ME).find('.save-camera-settings').click(function(){\n  ME.DATA.camera = $(ME).find('#select-camera').val();\n  ME.DATA.device = $(ME).find('#select-device').val();\n  ME.DATA.format = $(ME).find('#select-format').val();\n  ME.DATA.resolution = $(ME).find('#select-resolution').val();\n  ME.DATA.rotation = $(ME).find('#select-rotation').val();\n  ME.DATA.framerate = $(ME).find('#select-fps').val();\n  ME.DATA.dvr = $(ME).find('#dvr-switch').prop('checked');\n  ME.DATA.motion_sensitivity = $(ME).find('.rvs-sense').val();\n  ME.DATA.motion_noise_cancel = $(ME).find('.rvs-noise').val();\n  ME.DATA.motion = $(ME).find('#motion-switch').prop('checked');\n  ME.DATA.recording = ME.DATA.dvr;\n  json(me.prefix+'camera/settings', \"settings=\"+encodeURIComponent(JSON.stringify(ME.DATA)), function(result) {\n    $(ME).closest('.settings-popup').find('.close-camera-settings').click();\n  });\n});\n\n$(ME).find('#motion-switch').on('change', function(){\n  var dis = $(this).prop('checked') ? 'block' : 'none';\n  $(ME).find('.motion-settings').css('display', dis);\n});\n\n$(ME).find('#keyframe').on(\"load\", function(){\n  if ($(this).prop('src').indexOf('no_signal.jpg') != -1) setTimeout(keyFrame, 1000);\n  else setTimeout(keyFrame, 2000);\n});\n$(ME).find('#keyframe').on(\"error\", function(){\n  $(this).prop('src', me.prefix+'app/asset/camera/no_signal.jpg');\n});\n","patch_id":"p10","time":1793967065329},{"author":"claude-code","facet":"css","label":"C6: section titles, dimmed recording fields, footer error line","new":"/* C6: two titled sections, Camera and Recording */\n.camera-settings-popup .section-title {\n  font-size:12px;\n  font-weight:600;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n  color:var(--text-dim);\n  margin:4px 0 12px;\n}\n\n.camera-settings-popup .section-note {\n  display:none;\n  color:var(--text-dim);\n  font-style:italic;\n  margin-bottom:12px;\n}\n\n.camera-settings-popup .switchrow {\n  display:block;\n  margin:4px 0 8px;\n  cursor:pointer;\n}\n\n.camera-settings-popup .rec-fields {\n  max-width:280px;\n  transition:opacity .15s;\n}\n\n.camera-settings-popup .rec-fields .textinputlabel {\n  margin-top:12px;\n}\n\n.camera-settings-popup .rec-fields .switchrow {\n  margin-top:16px;\n}\n\n/* DVR off: the recording fields stay visible but dimmed until DVR is on */\n.camera-settings-popup .rec-fields.dimmed {\n  opacity:.45;\n}\n\n.camera-settings-popup .motion-settings {\n  display:none;\n  margin:8px 16px 0;\n}\n\n.camera-settings-popup .save-error {\n  display:none;\n  color:var(--danger);\n  margin-bottom:8px;\n}\n\n/* C9: the current slider value, beside its label */","old":"/* C9: the current slider value, beside its label */","patch_id":"p11","time":1793967082118},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> camera.dvr_settings","new":"[\n{\"claim\": \"The camera settings dialog always shows both sections (Camera via camera_settings, Recording via dvr_settings); every save with DVR on restarts recording (settings.rs stops and restarts the capture), so the Camera section says 'Saving restarts recording.' while the DVR switch is on.\", \"detail\": \"Session 3 C6 (2026-11-06). The dialog is mounted fresh on every open, so it refetches camera/settings each time. Save sends only real values (a missing field must not overwrite a stored setting with null), including storage, which start_recording reads on each start, so a new directory takes effect at once. A failed save (top-level err, or the command's own {status:err} wrapped as data) shows in the sticky footer and keeps the dialog open. Switches are class-based (no ids) so two tiles' dialogs don't cross-toggle. While recording, camera_settings previews last_keyframe instead of a second capture, and its preview loop stops when the dialog is hidden.\", \"tags\": \"camera,settings,dialog,dvr,C6,C5\", \"source\": {\"lib\": \"camera\", \"ctl\": \"dvr_settings\", \"facet\": \"js\", \"hash\": \"0294888c3db540c2\"}, \"confidence\": \"high\", \"time\": 1793967587369},\n{\"end\": true}]\n","old":"","patch_id":"p12","time":1793967591049},{"author":"claude","facet":"js","label":"dvr_settings: the page decides the peer, not the stored settings","new":"    // the viewing page decides the peer, never the stored settings: an\n    // old save left this machine's own uuid in botd.properties as \"peer\",\n    // and $.extend skips an undefined value, so a local page inherited it\n    // and asked peer/remote/<own uuid> (\"No such peer\")\n    var cs = $.extend({}, me.settings, { peer: ME.DATA.peer || null });","old":"    var cs = $.extend({}, me.settings, { peer: ME.DATA.peer });","patch_id":"p13","time":1794153611724}]},"id":"rouoou18458b6684eq139_patches","readers":[],"time":1794153611724,"username":"system","writers":[]}